<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <UseWPF>true</UseWPF>
    <!-- Windows Forms only for the Windows font dialog (FontDialog); its namespaces are not imported globally -->
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>Multiplot.App</RootNamespace>
    <AssemblyName>Multiplot</AssemblyName>
    <ApplicationIcon>Resources\Multiplot.ico</ApplicationIcon>
    <PlatformTarget>x64</PlatformTarget>
    <Version>1.0.0</Version>
    <Product>Multiplot.NET</Product>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>
  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>
  <!-- OpenTelemetry SDK + OTLP exporter (NFR-TEL-001, Apache-2.0). Only the executable references the SDK;
       the libraries use the BCL ActivitySource/Meter in Multiplot.Core.Diagnostics. Keep all core packages on one version. -->
  <PropertyGroup>
    <OpenTelemetryVersion>1.21.0</OpenTelemetryVersion>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="OpenTelemetry" Version="$(OpenTelemetryVersion)" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="$(OpenTelemetryVersion)" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Multiplot.Application\Multiplot.Application.csproj" />
    <!-- bundled plugin: built first, deployed to plugins\Multiplot.Parquet\ (not referenced) -->
    <ProjectReference Include="..\Multiplot.Parquet\Multiplot.Parquet.csproj" ReferenceOutputAssembly="false" Private="false" SkipGetTargetFrameworkProperties="true" />
  </ItemGroup>
  <PropertyGroup>
    <ParquetPluginOutput>$(MSBuildThisFileDirectory)..\Multiplot.Parquet\bin\$(Configuration)\net10.0\</ParquetPluginOutput>
  </PropertyGroup>
  <Target Name="DeployParquetPlugin" AfterTargets="Build">
    <ItemGroup>
      <ParquetPluginFiles Include="$(ParquetPluginOutput)**\*" Exclude="$(ParquetPluginOutput)**\*.pdb" />
    </ItemGroup>
    <Copy SourceFiles="@(ParquetPluginFiles)" DestinationFiles="@(ParquetPluginFiles->'$(OutDir)plugins\Multiplot.Parquet\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>
  <Target Name="PublishParquetPlugin" AfterTargets="Publish">
    <ItemGroup>
      <ParquetPluginPublishFiles Include="$(ParquetPluginOutput)**\*" Exclude="$(ParquetPluginOutput)**\*.pdb" />
    </ItemGroup>
    <Copy SourceFiles="@(ParquetPluginPublishFiles)" DestinationFiles="@(ParquetPluginPublishFiles->'$(PublishDir)plugins\Multiplot.Parquet\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>
  <ItemGroup>
    <Resource Include="Resources\Multiplot.ico" />
    <None Update="Multiplot.ini" CopyToOutputDirectory="PreserveNewest" />
    <None Update="ColorPrinter.wps" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <!-- user guide: docs\user-guide\*.md converted to HTML (docs\user-guide\index.html), opened in the browser by Help > User Guide -->
  <ItemGroup>
    <ProjectReference Include="..\..\tools\HelpBuilder\HelpBuilder.csproj" ReferenceOutputAssembly="false" Private="false" SkipGetTargetFrameworkProperties="true" />
    <UserGuideSource Include="..\..\docs\user-guide\*.md" />
  </ItemGroup>
  <PropertyGroup>
    <HelpBuilderDll>$(MSBuildThisFileDirectory)..\..\tools\HelpBuilder\bin\$(Configuration)\net10.0\helpbuilder.dll</HelpBuilderDll>
    <HelpBuilderHost Condition="'$(DOTNET_HOST_PATH)' != ''">$(DOTNET_HOST_PATH)</HelpBuilderHost>
    <HelpBuilderHost Condition="'$(DOTNET_HOST_PATH)' == ''">dotnet</HelpBuilderHost>
    <UserGuideSourceDir>$(MSBuildThisFileDirectory)..\..\docs\user-guide</UserGuideSourceDir>
  </PropertyGroup>
  <Target Name="BuildUserGuide" AfterTargets="Build" Inputs="@(UserGuideSource);$(HelpBuilderDll)" Outputs="$(OutDir)docs\user-guide\index.html">
    <Exec Command="&quot;$(HelpBuilderHost)&quot; &quot;$(HelpBuilderDll)&quot; &quot;$(UserGuideSourceDir)&quot; &quot;$(OutDir)docs\user-guide&quot;" />
  </Target>
  <Target Name="PublishUserGuide" AfterTargets="Publish">
    <Exec Command="&quot;$(HelpBuilderHost)&quot; &quot;$(HelpBuilderDll)&quot; &quot;$(UserGuideSourceDir)&quot; &quot;$(PublishDir)docs\user-guide&quot;" />
  </Target>
</Project>
