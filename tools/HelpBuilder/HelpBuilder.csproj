<Project Sdk="Microsoft.NET.Sdk">
  <!-- Converts the Markdown user guide (docs/user-guide) to the HTML pages shipped with the application. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>HelpBuilder</RootNamespace>
    <AssemblyName>helpbuilder</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Markdig.Signed" Version="0.43.0" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="guide.css" LogicalName="HelpBuilder.guide.css" />
  </ItemGroup>
</Project>
